      "parameters": {
        "jsCode": "// This Code node expects you may receive MULTIPLE incoming items:\n// - One item that contains the original form fields (First Name, Email, etc.)\n// - One item that contains the ChatGPT \"output\" wrapper with the JSON text\n//\n// Update: If Date is empty, set it to today's date (YYYY-MM-DD).\n\nconst items = $input.all().map(i => i.json);\n\n// --- Helpers ---\nconst hasSubmissionShape = (obj) => {\n  if (!obj || typeof obj !== \"object\") return false;\n  const keys = [\"First Name\", \"Last Name\", \"Email\", \"Phone\", \"Zip\", \"Service\", \"Message\", \"Page url\"];\n  let count = 0;\n  for (const k of keys) if (k in obj) count++;\n  return count >= 3;\n};\n\nconst extractAiText = (obj) => {\n  return obj?.output?.[0]?.content?.[0]?.text ?? null;\n};\n\nfunction computePageName(url) {\n  const u = (url || \"\").toString().trim();\n  if (!u) return \"NA\";\n  try {\n    const parsed = new URL(u);\n    const path = (parsed.pathname || \"\").replace(/\\/+$/, \"\");\n    if (!path) return \"Home\";\n    const seg = path.split(\"/\").filter(Boolean)[0];\n    if (!seg) return \"Home\";\n    return seg\n      .replace(/[-_]+/g, \" \")\n      .replace(/\\b\\w/g, (c) => c.toUpperCase());\n  } catch (e) {\n    if (u === \"/\" || u.endsWith(\"mfclaw.com\") || u.endsWith(\"mfclaw.com/\")) return \"Home\";\n    return \"NA\";\n  }\n}\n\nfunction splitName(full) {\n  const s = (full || \"\").toString().trim();\n  if (!s) return { first: \"\", last: \"\" };\n  const parts = s.split(/\\s+/);\n  return {\n    first: parts[0] || \"\",\n    last: parts.length > 1 ? parts.slice(1).join(\" \") : \"\"\n  };\n}\n\nfunction todayISO() {\n  // n8n runs in server timezone; this yields YYYY-MM-DD\n  const d = new Date();\n  return d.toISOString().slice(0, 10);\n}\n\n// --- 1) Find submission + AI text from ANY incoming item ---\nlet submission = {};\nlet aiText = null;\n\nfor (const obj of items) {\n  if (!aiText) {\n    const maybeText = extractAiText(obj);\n    if (maybeText) aiText = maybeText;\n  }\n  if (!Object.keys(submission).length && hasSubmissionShape(obj)) {\n    submission = obj;\n  }\n}\n\n// If the submission was nested under \"submission\", handle that too\nif (!Object.keys(submission).length) {\n  for (const obj of items) {\n    const nested = obj?.submission;\n    if (hasSubmissionShape(nested)) {\n      submission = nested;\n      break;\n    }\n    if (Array.isArray(nested) && hasSubmissionShape(nested[0])) {\n      submission = nested[0];\n      break;\n    }\n  }\n}\n\n// --- 2) Parse triage JSON (your model now outputs the final sheet object) ---\nlet triage = null;\ntry {\n  triage = aiText ? JSON.parse(aiText) : null;\n} catch (e) {\n  triage = null;\n}\n\n// Fallback if parsing fails\nif (!triage || typeof triage !== \"object\") {\n  triage = {};\n}\n\n// --- 3) Pull values (prefer triage since it already outputs your fields) ---\nconst outFirstName = triage[\"First Name\"] ?? submission[\"First Name\"] ?? \"\";\nconst outLastName  = triage[\"Last Name\"] ?? submission[\"Last Name\"] ?? \"\";\nconst outEmail     = triage[\"Email\"] ?? submission[\"Email\"] ?? \"\";\nconst outPhone     = triage[\"Phone\"] ?? submission[\"Phone\"] ?? \"\";\nconst outZip       = triage[\"Zip\"] ?? submission[\"Zip\"] ?? \"\";\nconst outService   = triage[\"Service\"] ?? submission[\"Service\"] ?? \"\";\nconst outMessage   = triage[\"Message\"] ?? submission[\"Message\"] ?? \"\";\nconst outEntryId   = triage[\"Entry Id\"] ?? submission[\"Entry Id\"] ?? \"\";\n\nconst outPageUrl   = triage[\"Page url\"] ?? submission[\"Page url\"] ?? submission[\"Page URL\"] ?? \"\";\nconst outPageName  =\n  triage[\"Page Name\"] ??\n  submission[\"Page Name\"] ??\n  computePageName(outPageUrl);\n\nlet outDate = triage[\"Date\"] ?? submission[\"Date\"] ?? \"\";\noutDate = String(outDate || \"\").trim() ? outDate : todayISO();\n\nconst outAIStatus  = triage[\"AI Status\"] ?? submission[\"AI Status\"] ?? \"\";\nconst outEmailStat = triage[\"Email Status\"] ?? submission[\"Email Status\"] ?? \"\";\n\n// --- 4) Return exact columns ---\nreturn [\n  {\n    json: {\n      \"First Name\": outFirstName,\n      \"Last Name\": outLastName,\n      \"Email\": outEmail,\n      \"Phone\": outPhone,\n      \"Zip\": outZip,\n      \"Service\": outService,\n      \"Message\": outMessage,\n      \"Entry Id\": outEntryId,\n      \"Page url\": outPageUrl,\n      \"Page Name\": outPageName,\n      \"Date\": outDate,\n      \"AI Status\": outAIStatus,\n      \"Email Status\": outEmailStat\n    }\n  }\n];"
      },
