        "sendTo": "={{ $('Append row in sheet').item.json.Email }}",
        "subject": "Performance review of your website",
        "message": "=<div style=\"margin:0; padding:0; font-family:Arial, Helvetica, sans-serif; color:#111827;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"width:100%; border-collapse:collapse; margin:0; padding:0;\">\n    <tr>\n      <td align=\"center\" style=\"margin:0; padding:0;\">\n        <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:680px; width:100%; border-collapse:separate; border-spacing:0; background-color:#ffffff; border-radius:14px; overflow:hidden; border:1px solid #e5e7eb; margin:0;\">\n          \n          <tr>\n            <td style=\"padding:40px 32px 28px 32px; background-color:#975554; border-radius:14px 14px 0 0;\" align=\"center\">\n              <div style=\"font-size:24px; line-height:32px; font-weight:700; color:#ffffff;\">\n                Social Engagement Group\n              </div>\n              <div style=\"font-size:14px; line-height:22px; color:#f3e8e6; margin-top:6px;\">\n                Website Performance Audit Summary\n              </div>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:30px 32px 10px 32px;\">\n              <div style=\"font-size:16px; line-height:26px; color:#111827;\">\n                Hi {{ $('Edit Fields').item.json.query.name }},\n              </div>\n              <div style=\"font-size:16px; line-height:26px; color:#111827; margin-top:12px;\">\n                We ran a quick performance review of your website and found a few areas that may be slowing things down and affecting user experience.\n              </div>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:10px 32px;\">\n              <div style=\"background-color:#f8fafc; border:1px solid #e5e7eb; border-radius:12px; padding:20px;\">\n                <div style=\"font-size:13px; line-height:20px; font-weight:700; color:#475569; text-transform:uppercase; letter-spacing:0.4px; margin-bottom:8px;\">\n                  Audit Summary\n                </div>\n                <div style=\"font-size:18px; line-height:30px; font-weight:700; color:#111827; margin-bottom:8px;\">\n                  {{$json[\"site_score_summary\"]}}\n                </div>\n                <div style=\"font-size:14px; line-height:24px; color:#475569;\">\n                  Website reviewed:\n                  <a href=\"{{ $('Edit Fields').item.json.query.url }}\" style=\"color:#975554; text-decoration:none;\">\n                    {{ $('Edit Fields').item.json.query.url }}\n                  </a>\n                </div>\n              </div>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:20px 32px 10px 32px;\">\n              <div style=\"font-size:18px; line-height:28px; font-weight:700; color:#111827; margin-bottom:12px;\">\n                Key Issues Identified\n              </div>\n\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\n                <tr>\n                  <td style=\"padding:0 0 10px 0;\">\n                    <div style=\"background-color:#fff7ed; border:1px solid #fed7aa; border-radius:10px; padding:14px 16px; font-size:15px; line-height:24px; color:#9a3412;\">\n                      1. {{$json[\"main_issues\"][0]}}\n                    </div>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:0 0 10px 0;\">\n                    <div style=\"background-color:#fff7ed; border:1px solid #fed7aa; border-radius:10px; padding:14px 16px; font-size:15px; line-height:24px; color:#9a3412;\">\n                      2. {{$json[\"main_issues\"][1]}}\n                    </div>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:0;\">\n                    <div style=\"background-color:#fff7ed; border:1px solid #fed7aa; border-radius:10px; padding:14px 16px; font-size:15px; line-height:24px; color:#9a3412;\">\n                      3. {{$json[\"main_issues\"][2]}}\n                    </div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:24px 32px 10px 32px;\">\n              <div style=\"font-size:18px; line-height:28px; font-weight:700; color:#111827; margin-bottom:12px;\">\n                Recommended Fixes\n              </div>\n\n              <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border-collapse:collapse;\">\n                <tr>\n                  <td style=\"padding:0 0 10px 0;\">\n                    <div style=\"background-color:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:14px 16px; font-size:15px; line-height:24px; color:#1d4ed8;\">\n                      1. {{$json[\"recommended_fixes\"][0]}}\n                    </div>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:0 0 10px 0;\">\n                    <div style=\"background-color:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:14px 16px; font-size:15px; line-height:24px; color:#1d4ed8;\">\n                      2. {{$json[\"recommended_fixes\"][1]}}\n                    </div>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:0;\">\n                    <div style=\"background-color:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:14px 16px; font-size:15px; line-height:24px; color:#1d4ed8;\">\n                      3. {{$json[\"recommended_fixes\"][2]}}\n                    </div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:24px 32px 10px 32px;\">\n              <div style=\"background-color:#f0fdf4; border:1px solid #bbf7d0; border-radius:12px; padding:18px 20px;\">\n                <div style=\"font-size:16px; line-height:26px; font-weight:700; color:#166534; margin-bottom:8px;\">\n                  Why This Matters\n                </div>\n                <div style=\"font-size:15px; line-height:25px; color:#166534;\">\n                  {{$json[\"impact_if_fixed\"]}}\n                </div>\n              </div>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:28px 32px 10px 32px;\" align=\"center\">\n              <div style=\"font-size:16px; line-height:26px; color:#111827; margin-bottom:18px;\">\n                {{$json[\"agency_cta\"]}}\n              </div>\n              <a\n                href=\"https://calendly.com/itseg/segmeet\"\n                target=\"_blank\"\n                style=\"display:inline-block; background-color:#975554; color:#ffffff; text-decoration:none; font-size:16px; font-weight:700; padding:14px 28px; border-radius:10px;\"\n              >\n                Book a Call\n              </a>\n            </td>\n          </tr>\n\n         <tr>\n  <td style=\"padding:30px 32px 32px 32px;\" align=\"center\">\n    <div style=\"font-size:14px; line-height:24px; color:#475569;\">\n      Social Engagement Group\n    </div>\n    <div style=\"font-size:14px; line-height:24px; color:#475569;\">\n      <a href=\"https://www.socialengagementgroup.com/\" style=\"color:#975554; text-decoration:none;\">\n        www.socialengagementgroup.com\n      </a>\n    </div>\n    <div style=\"font-size:14px; line-height:24px; color:#475569; padding-top:10px;\">\n      <a href=\"https://www.instagram.com/socialengagementgroup\" style=\"color:#975554; text-decoration:none; margin:0 8px;\">\n        Instagram\n      </a>\n      <span style=\"color:#cbd5e1;\">|</span>\n      <a href=\"https://www.linkedin.com/company/social-engagement-group\" style=